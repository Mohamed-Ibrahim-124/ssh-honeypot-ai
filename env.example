# Environment variables template
# Copy this file to .env and modify as needed

# Application settings
APP_NAME=SSH Honeypot
APP_VERSION=1.0.0
DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=8000

# AI Model settings - Choose your preferred model
# Primary model (try first)
AI_MODEL_NAME=microsoft/DialoGPT-small

# Fallback model (if primary fails)
AI_MODEL_FALLBACK=distilgpt2

# Device settings
AI_MODEL_DEVICE=auto

# Generation settings
AI_MAX_TOKENS=150
AI_TEMPERATURE=0.6

# Enable quantization for better performance (requires CUDA)
AI_USE_QUANTIZED=true

# Alternative quantized models you can try:
# AI_MODEL_NAME=microsoft/DialoGPT-medium
# AI_MODEL_NAME=gpt2
# AI_MODEL_NAME=distilgpt2
# AI_MODEL_NAME=EleutherAI/gpt-neo-125M

# Honeypot settings
FAKE_SYSTEM_ENABLED=true
SESSION_TIMEOUT=3600
MAX_COMMANDS_PER_SESSION=100

# Security settings
ENABLE_CORS=true
CORS_ORIGINS=["*"]

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
